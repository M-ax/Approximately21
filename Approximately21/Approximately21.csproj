        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(ApproximatelyUpDirectory)\BepInEx\interop\UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.AssetBundleModule">
            <HintPath>$(ApproximatelyUpDirectory)\BepInEx\interop\UnityEngine.AssetBundleModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="..\lib\BlackjackTableBundle\Built\BlackjackTableMesh.bin">
        <LogicalName>Approximately21.BlackjackTableMesh.bin</LogicalName>
        <Link>Assets\BlackjackTableMesh.bin</Link>
      </EmbeddedResource>
    </ItemGroup>
</Project>
